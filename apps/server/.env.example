# Copy to .env and fill in. Never commit .env.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Sign-up is invite only. Share this code with the people you invite; at least 16 characters.
# Generate one with: openssl rand -hex 16
INVITE_CODE=
# The address people open in the browser. In development that is the Vite server.
BETTER_AUTH_URL=http://localhost:5173
# Matches packages/db/docker-compose.yml (local development only).
DATABASE_URL=postgresql://postgres:password@localhost:5432/steady
