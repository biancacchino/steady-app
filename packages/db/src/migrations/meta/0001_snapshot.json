      "checkConstraints": {
        "journal_entry_food_or_symptom": {
          "name": "journal_entry_food_or_symptom",
          "value": "\"journal_entry\".\"food\" is not null or \"journal_entry\".\"symptom\" is not null"
        },
        "journal_entry_food_length": {
          "name": "journal_entry_food_length",
          "value": "\"journal_entry\".\"food\" ~ '[^\\t\\n\\v\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\u00AD\\u034F\\u061C\\u115F\\u1160\\u17B4\\u17B5\\u180B-\\u180F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\u3164\\uFE00-\\uFE0F\\uFEFF\\uFFA0]' and char_length(\"journal_entry\".\"food\") <= 1000"
        },
        "journal_entry_symptom_length": {
          "name": "journal_entry_symptom_length",
          "value": "\"journal_entry\".\"symptom\" ~ '[^\\t\\n\\v\\f\\r \\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\u00AD\\u034F\\u061C\\u115F\\u1160\\u17B4\\u17B5\\u180B-\\u180F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\u3164\\uFE00-\\uFE0F\\uFEFF\\uFFA0]' and char_length(\"journal_entry\".\"symptom\") <= 1000"
        },
        "journal_entry_time_zone_length": {
          "name": "journal_entry_time_zone_length",
          "value": "char_length(\"journal_entry\".\"time_zone\") between 1 and 64"
        },
        "journal_entry_severity_value": {
          "name": "journal_entry_severity_value",
          "value": "\"journal_entry\".\"severity\" in ('low', 'medium', 'high')"
        },
        "journal_entry_severity_needs_symptom": {
          "name": "journal_entry_severity_needs_symptom",
          "value": "\"journal_entry\".\"severity\" is null or \"journal_entry\".\"symptom\" is not null"
        },
        "journal_entry_context_values": {
          "name": "journal_entry_context_values",
          "value": "\"journal_entry\".\"context\" <@ array['stress', 'travel', 'sleep', 'cycle']::text[]"
        }
